Algoritmo "positivoounegativo"
//  
//  

Var
//
num: inteiro

Inicio
// Condicionais para saber se é positivo e negativo
escreva("Digite um número: ")
leia(num)

se num < 0 entao
   escreval("O número ",num," é negativo")
   fimse
se num > 0 entao
   escreval("o número ", num, " é positivo")
   fimse

Fimalgoritmo
