Algoritmo "parimpar"

Var
//declaro a variável
numero: real

Inicio
//peço ao usuário um número
escreval("Digite um número: ")
leia(numero)
//condição para saber se o número é impar ou par usando mod (resto)
se numero mod 2 = 0 entao
   escreval("NUMERO ***PAR***")
senao
     escreval("NÚMERO ***ÍMPAR***")
fimse


Fimalgoritmo