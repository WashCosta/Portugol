Algoritmo "tabuadaWASHINGTON/GUSTAVO"
//TABUADAAAAA
Var
// VARIÁVEIS
num,contador, resultado: inteiro

Inicio
//PEÇO AO USUÁRIO UM NÚMERO P/ TABUADA
escreval("DIGITE UM NÚMERO: ")
leia(num)
para contador de 0 ate 10 faca
resultado <- num * contador
escreval("===TABUADA DO NÚMERO ",num,"===")
escreval(num," X ",contador, " = ",resultado)
fimpara
Fimalgoritmo
